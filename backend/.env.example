# =============================================================================
# VendeoAI — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV="development"

# ─────────────────────────────────────────────────────────────────────────────
# URLs
# ─────────────────────────────────────────────────────────────────────────────

# Backend API URL
BACKEND_URL="http://localhost:5000"

# Frontend URL (used for CORS)
FRONTEND_URL="http://localhost:3000"

# Public application URL
APP_URL="http://localhost:3000"

# Application name
APP_TITLE="VendeoAI"

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────

DATABASE_URL="postgresql://postgres:password@localhost:5432/vendeo_ia"

# ─────────────────────────────────────────────────────────────────────────────
# User Authentication JWT
# ─────────────────────────────────────────────────────────────────────────────

# Access Token
JWT_SECRET="replace_with_a_random_string_of_at_least_32_characters"
JWT_EXPIRATION="15m"

# Refresh Token
JWT_REFRESH_SECRET="replace_with_a_different_random_string_of_at_least_32_characters"
JWT_REFRESH_EXPIRATION="7d"

# ─────────────────────────────────────────────────────────────────────────────
# Admin Authentication JWT
# ─────────────────────────────────────────────────────────────────────────────

# MUST be different from user JWT secrets
ADMIN_JWT_SECRET="replace_with_admin_access_secret"
ADMIN_JWT_REFRESH_SECRET="replace_with_admin_refresh_secret"

# Default Super Admin account
# Created automatically at startup if not found
SUPER_ADMIN_EMAIL="admin@vendeoai.com"
SUPER_ADMIN_PASSWORD="ChangeMeImmediately123!"

# ─────────────────────────────────────────────────────────────────────────────
# AI / OpenRouter
# ─────────────────────────────────────────────────────────────────────────────

OPENROUTER_API_KEY="sk-or-v1-your_openrouter_key_here"

# ─────────────────────────────────────────────────────────────────────────────
# Google OAuth
# ─────────────────────────────────────────────────────────────────────────────

GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxx"
GOOGLE_CALLBACK_URL="http://localhost:5000/auth/google/callback"

# ─────────────────────────────────────────────────────────────────────────────
# Facebook / Meta
# ─────────────────────────────────────────────────────────────────────────────

FACEBOOK_APP_ID="your_app_id"
FACEBOOK_APP_SECRET="your_app_secret"

FACEBOOK_VERIFY_TOKEN="your_verify_token_here"

FACEBOOK_OAUTH_REDIRECT_URI="http://localhost:5000/facebook/callback"

# AES-256-GCM encryption key (64 hex chars)
FACEBOOK_TOKEN_ENCRYPTION_KEY="your_64_char_hex_key_here"

# ─────────────────────────────────────────────────────────────────────────────
# PAPI
# ─────────────────────────────────────────────────────────────────────────────

PAPI_API_KEY="your_papi_api_key"

# ─────────────────────────────────────────────────────────────────────────────
# Email (Resend)
# ─────────────────────────────────────────────────────────────────────────────

RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="VendeoAI <noreply@vendeoai.com>"

# ─────────────────────────────────────────────────────────────────────────────
# Push Notifications (Web Push)
# ─────────────────────────────────────────────────────────────────────────────

VAPID_PUBLIC_KEY="your_vapid_public_key_here"
VAPID_PRIVATE_KEY="your_vapid_private_key_here"
VAPID_EMAIL="mailto:contact@vendeoai.com"