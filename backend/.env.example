# =============================================================================
# VendeoAI — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
#
# All variables are validated at startup by src/config/validation.ts.
# The app will refuse to start if any required variable is missing.
# =============================================================================

# ── Server ────────────────────────────────────────────────────────────────────

# HTTP port the server listens on
# Default: 5000
PORT=5000

# Runtime environment — controls logging level, HSTS, CSP, etc.
# Values: development | production | test
NODE_ENV="development"

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Required
DATABASE_URL="postgresql://postgres:password@localhost:5432/vendeo_ia"

# ── Frontend ──────────────────────────────────────────────────────────────────

# Format: https://yourdomain.com (no trailing slash)
# Default: http://localhost:5000
BACKEND_URL=https://api-vendeoai.fadevt.org

# Base URL of the Next.js frontend (used by CORS)
# No trailing slash
# Required
FRONTEND_URL="http://localhost:3000"

# Public app URL sent to OpenRouter as the HTTP-Referer header.
# Defaults to FRONTEND_URL when omitted.
APP_URL="http://localhost:3000"

# App name sent to OpenRouter as the X-Title header.
APP_TITLE="VendeoAI"

# ── JWT — Access Token ────────────────────────────────────────────────────────

# Secret used to sign short-lived access tokens (15 min)
# Minimum 32 characters — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required — MUST differ from JWT_REFRESH_SECRET
JWT_SECRET="replace_with_a_random_string_of_at_least_32_characters"

# Access token lifetime
# Format: ms/vercel zeit format (15m, 1h, 24h…)
# Default: 15m
JWT_EXPIRATION="15m"

# ── JWT — Refresh Token ───────────────────────────────────────────────────────

# Secret used to sign long-lived refresh tokens (7 days)
# Minimum 32 characters — MUST be different from JWT_SECRET
# Required
JWT_REFRESH_SECRET=replace_with_a_different_random_string_of_at_least_32_characters

# Refresh token lifetime
# Default: 7d
JWT_REFRESH_EXPIRATION="7d"

# ── AI / OpenRouter ──────────────────────────────────────────────────────────

# OpenRouter API key used for AI replies, summaries, and model listing
# Create one at: https://openrouter.ai/settings/keys
# Required
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# ── Facebook App ──────────────────────────────────────────────────────────────

# From your Meta App Dashboard → Settings → Basic
FACEBOOK_APP_ID=your_app_id
FACEBOOK_APP_SECRET=your_app_secret

# Arbitrary string — set the same value in your Meta App webhook settings
FACEBOOK_VERIFY_TOKEN=your_verify_token_here

# Must match the redirect URI registered in your Meta App OAuth settings
# Format: https://yourdomain.com/facebook/callback
FACEBOOK_OAUTH_REDIRECT_URI=http://api-vendeoai.fadevt.org/facebook/callback

# 32-byte hex key for AES-256-GCM encryption of stored page tokens
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FACEBOOK_TOKEN_ENCRYPTION_KEY=your_64_char_hex_key_here


# --------- PAPI API key
PAPI_API_KEY=ta_clé_depuis_dashboard.papi.mg

# ── Web Push Notifications (VAPID) ───────────────────────────────────────────
# VAPID keys for Web Push notifications (used for inbox alerts)
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here

  VAPID_EMAIL=mailto:contact@vendeoai.com